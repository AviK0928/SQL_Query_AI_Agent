# Copy to .env and fill in. .env is gitignored - never commit it.
# Environment variables override values in .env. See README "Configuration".

# Required
GROQ_API_KEY=your-groq-api-key-here
# Check the current Groq model catalog before relying on this value.
GROQ_MODEL=openai/gpt-oss-120b

# Optional (defaults shown)
# DB_PATH=database/ecommerce.db
# MAX_ROWS=200
# QUERY_TIMEOUT_S=5.0
# MAX_HISTORY_TURNS=3
