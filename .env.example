# Copy to .env and fill in. .env is gitignored - never commit it.
# Environment variables override values in .env. See README "Configuration".

# Required
GROQ_API_KEY=your-groq-api-key-here
# Check the current Groq model catalog before relying on this value.
GROQ_MODEL=openai/gpt-oss-120b
# Per-model limits, copied from console.groq.com/settings/limits (they change).
# Every model the app can call (GROQ_MODEL, GROQ_FALLBACK_MODEL, LLM_ROLE_MODELS)
# needs an entry. Values below were read on 25 Sep 2026; re-check before use.
LLM_LIMITS={"openai/gpt-oss-120b": {"rpm": 30, "rpd": 1000, "tpm": 8000, "tpd": 200000}, "openai/gpt-oss-20b": {"rpm": 30, "rpd": 1000, "tpm": 8000, "tpd": 200000}}

# Optional (defaults shown)
# DB_PATH=database/ecommerce.db
# MAX_ROWS=200
# QUERY_TIMEOUT_S=5.0
# MAX_HISTORY_TURNS=3
# MAX_REPAIR_ATTEMPTS=1

# LLM client (optional)
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_ROLE_MODELS={"synthesizer": "openai/gpt-oss-20b"}
# LLM_SAFETY_MARGIN=0.8
# LLM_MAX_WAIT_S=20
# LLM_TIMEOUT_S=30
# LLM_MAX_ATTEMPTS=3
# LLM_CACHE_PATH=/content/drive/MyDrive/sql_agent/llm_cache.sqlite
# LLM_LOG_CONTENT=false
# LLM_LOG_PATH=logs/llm_calls.jsonl
