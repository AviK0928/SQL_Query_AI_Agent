{"id": "b01", "tier": "T1", "kind": "sql", "turns": ["List the customers who live in Delhi."], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "a77a6f5a5597", "schema_hash": "cace08063546", "commit": "fa4963f", "ran_at": "2026-09-25T10:06:20+00:00", "answer": "The customers living in Delhi are Kabir Singh, Nikhil Verma, and Karan Malhotra.", "sql": "SELECT id, name, email, city, signup_date FROM customers WHERE city = 'Delhi' LIMIT 100", "columns": ["id", "name", "email", "city", "signup_date"], "rows_sample": [[5, "Kabir Singh", "kabir.singh@example.com", "Delhi", "2024-01-09"], [11, "Nikhil Verma", "nikhil.verma@example.com", "Delhi", "2024-04-19"], [15, "Karan Malhotra", "karan.malhotra@example.com", "Delhi", "2024-06-27"]], "row_count": 3, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 3, "got_row_count": 3, "exact_match": false, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 889, "output_tokens": 158, "latency_s": 0.802, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b02", "tier": "T2", "kind": "sql", "turns": ["What is the total revenue?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "a77a6f5a5597", "schema_hash": "cace08063546", "commit": "fa4963f", "ran_at": "2026-09-25T10:06:24+00:00", "answer": "The total revenue is Rs 183,530.", "sql": "SELECT SUM(oi.unit_price * oi.quantity) AS total_revenue FROM order_items AS oi JOIN orders AS o ON oi.order_id = o.id WHERE o.status <> 'cancelled' LIMIT 201", "columns": ["total_revenue"], "rows_sample": [[183530.0]], "row_count": 1, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 1, "got_row_count": 1, "exact_match": true, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 806, "output_tokens": 197, "latency_s": 0.823, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b03", "tier": "T3", "kind": "sql", "turns": ["Show each order ID with the name of the customer who placed it."], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "a77a6f5a5597", "schema_hash": "cace08063546", "commit": "fa4963f", "ran_at": "2026-09-25T10:06:33+00:00", "answer": "The result lists each order ID together with the customer who placed it (e.g., orders 1, 5, 18 belong to Aarav Sharma, orders 3, 14, 28 to Diya Patel, etc.). Only the first 20 of the 30 matching rows are shown.", "sql": "SELECT orders.id AS order_id, customers.name AS customer_name FROM orders JOIN customers ON orders.customer_id = customers.id LIMIT 100", "columns": ["order_id", "customer_name"], "rows_sample": [[1, "Aarav Sharma"], [5, "Aarav Sharma"], [18, "Aarav Sharma"], [3, "Diya Patel"], [14, "Diya Patel"], [28, "Diya Patel"], [2, "Rohan Mehta"], [11, "Rohan Mehta"], [7, "Ananya Iyer"], [22, "Ananya Iyer"], [4, "Kabir Singh"], [25, "Kabir Singh"], [9, "Ishita Rao"], [30, "Ishita Rao"], [6, "Vikram Nair"], [27, "Vikram Nair"], [12, "Meera Joshi"], [13, "Meera Joshi"], [8, "Arjun Reddy"], [16, "Sara Khan"], [10, "Nikhil Verma"], [29, "Nikhil Verma"], [19, "Pooja Desai"], [21, "Riya Kapoor"], [15, "Karan Malhotra"], [23, "Tanvi Shah"], [17, "Dev Chauhan"], [26, "Neha Gupta"], [20, "Siddharth Menon"], [24, "Aisha Ali"]], "row_count": 30, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 30, "got_row_count": 30, "exact_match": true, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 979, "output_tokens": 333, "latency_s": 1.087, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b04", "tier": "T4", "kind": "sql", "turns": ["Which product categories appear in more than 8 orders?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "a77a6f5a5597", "schema_hash": "cace08063546", "commit": "fa4963f", "ran_at": "2026-09-25T10:06:42+00:00", "answer": "The categories that appear in more than 8 orders are **Accessories** and **Electronics**.", "sql": "SELECT p.category FROM order_items AS oi JOIN products AS p ON oi.product_id = p.id JOIN orders AS o ON oi.order_id = o.id WHERE o.status <> 'cancelled' GROUP BY p.category HAVING COUNT(DISTINCT o.id) > 8 LIMIT 100", "columns": ["category"], "rows_sample": [["Accessories"], ["Electronics"]], "row_count": 2, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 2, "got_row_count": 2, "exact_match": true, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 814, "output_tokens": 227, "latency_s": 0.999, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b05", "tier": "T5", "kind": "sql", "turns": ["How many orders were placed each month in 2024?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "a77a6f5a5597", "schema_hash": "cace08063546", "commit": "fa4963f", "ran_at": "2026-09-25T10:06:51+00:00", "answer": "In 2024 the monthly order counts were: Jan 2, Feb 2, Mar 3, Apr 2, May 1, Jun 2, Jul 2, Aug 1, Sep 2, Oct 1, Nov 2, Dec 2.", "sql": "SELECT STRFTIME('%Y-%m', order_date) AS month, COUNT(*) AS order_count FROM orders WHERE status <> 'cancelled' AND order_date BETWEEN '2024-01-01' AND '2024-12-31' GROUP BY month ORDER BY month LIMIT 100", "columns": ["month", "order_count"], "rows_sample": [["2024-01", 2], ["2024-02", 2], ["2024-03", 3], ["2024-04", 2], ["2024-05", 1], ["2024-06", 2], ["2024-07", 2], ["2024-08", 1], ["2024-09", 2], ["2024-10", 1], ["2024-11", 2], ["2024-12", 2]], "row_count": 12, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 12, "got_row_count": 12, "exact_match": false, "projection_match": false, "pass": false}, "llm_calls": 2, "input_tokens": 910, "output_tokens": 347, "latency_s": 1.064, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b06", "tier": "T6", "kind": "sql", "turns": ["What are the top 3 products by units sold?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "a77a6f5a5597", "schema_hash": "cace08063546", "commit": "fa4963f", "ran_at": "2026-09-25T10:07:00+00:00", "answer": "The top three products by units sold are Notebook Set (11 units), Gel Pen Pack (9 units), and Wireless Mouse (7 units). Only the first rows are shown.", "sql": "SELECT p.id, p.name, SUM(oi.quantity) AS units_sold FROM order_items AS oi JOIN orders AS o ON oi.order_id = o.id JOIN products AS p ON oi.product_id = p.id WHERE o.status <> 'cancelled' GROUP BY p.id, p.name ORDER BY units_sold DESC LIMIT 3", "columns": ["id", "name", "units_sold"], "rows_sample": [[10, "Notebook Set", 11], [11, "Gel Pen Pack", 9], [1, "Wireless Mouse", 7]], "row_count": 3, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 3, "got_row_count": 3, "exact_match": false, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 864, "output_tokens": 412, "latency_s": 2.183, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b07", "tier": "T7", "kind": "sql", "turns": ["What percentage of total revenue does each customer account for?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "a77a6f5a5597", "schema_hash": "cace08063546", "commit": "fa4963f", "ran_at": "2026-09-25T10:07:11+00:00", "answer": "Aarav Sharma accounts for 4.79% of total revenue, Diya Patel 5.5%, Rohan Mehta 9.53%, Ananya Iyer 15.69%, Kabir Singh 3.38%, Ishita Rao 2.18%, Vikram Nair 18.47%, Meera Joshi 1.11%, Arjun Reddy 1.8%, Sara Khan 1.8%, Nikhil Verma 4.57%, Pooja Desai 9.81%, Riya Kapoor 2.34%, Karan Malhotra 2.15%, Tanvi Shah 1.19%, Dev Chauhan 11.99%, Neha Gupta 0.87%, Siddharth Menon 1.31% and Aisha Ali 1.53% of total revenue.", "sql": "SELECT c.id, c.name, ROUND(SUM(oi.unit_price * oi.quantity) * 100.0 / (SELECT SUM(oi2.unit_price * oi2.quantity) FROM orders AS o2 JOIN order_items AS oi2 ON oi2.order_id = o2.id WHERE o2.status <> 'cancelled'), 2) AS revenue_percentage FROM customers AS c JOIN orders AS o ON o.customer_id = c.id AND o.status <> 'cancelled' JOIN order_items AS oi ON oi.order_id = o.id GROUP BY c.id, c.name HAVING SUM(oi.unit_price * oi.quantity) > 0 LIMIT 100", "columns": ["id", "name", "revenue_percentage"], "rows_sample": [[1, "Aarav Sharma", 4.79], [2, "Diya Patel", 5.5], [3, "Rohan Mehta", 9.53], [4, "Ananya Iyer", 15.69], [5, "Kabir Singh", 3.38], [6, "Ishita Rao", 2.18], [7, "Vikram Nair", 18.47], [8, "Meera Joshi", 1.11], [9, "Arjun Reddy", 1.8], [10, "Sara Khan", 1.8], [11, "Nikhil Verma", 4.57], [12, "Pooja Desai", 9.81], [14, "Riya Kapoor", 2.34], [15, "Karan Malhotra", 2.15], [16, "Tanvi Shah", 1.19], [17, "Dev Chauhan", 11.99], [18, "Neha Gupta", 0.87], [19, "Siddharth Menon", 1.31], [20, "Aisha Ali", 1.53]], "row_count": 19, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 19, "got_row_count": 19, "exact_match": false, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 1035, "output_tokens": 685, "latency_s": 1.74, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
