{"id": "b01", "tier": "T1", "kind": "sql", "turns": ["List the customers who live in Delhi."], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "637813813df8", "schema_hash": "cace08063546", "commit": "00caf5d", "ran_at": "2026-09-25T09:48:32+00:00", "answer": "The customers living in Delhi are Kabir Singh, Nikhil Verma, and Karan Malhotra.", "sql": "SELECT * FROM customers WHERE city = 'Delhi' LIMIT 100", "columns": ["id", "name", "email", "city", "signup_date"], "rows_sample": [[5, "Kabir Singh", "kabir.singh@example.com", "Delhi", "2024-01-09"], [11, "Nikhil Verma", "nikhil.verma@example.com", "Delhi", "2024-04-19"], [15, "Karan Malhotra", "karan.malhotra@example.com", "Delhi", "2024-06-27"]], "row_count": 3, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 3, "got_row_count": 3, "exact_match": false, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 841, "output_tokens": 196, "latency_s": 0.949, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b02", "tier": "T2", "kind": "sql", "turns": ["What is the total revenue?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "637813813df8", "schema_hash": "cace08063546", "commit": "00caf5d", "ran_at": "2026-09-25T09:48:37+00:00", "answer": "The total revenue is Rs 183,530.", "sql": "SELECT SUM(oi.unit_price * oi.quantity) AS total_revenue FROM order_items AS oi JOIN orders AS o ON oi.order_id = o.id WHERE o.status <> 'cancelled' LIMIT 201", "columns": ["total_revenue"], "rows_sample": [[183530.0]], "row_count": 1, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 1, "got_row_count": 1, "exact_match": true, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 758, "output_tokens": 222, "latency_s": 0.845, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b03", "tier": "T3", "kind": "sql", "turns": ["Show each order ID with the name of the customer who placed it."], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "637813813df8", "schema_hash": "cace08063546", "commit": "00caf5d", "ran_at": "2026-09-25T09:48:45+00:00", "answer": "The list shows each order ID paired with the name of the customer who placed that order (only the first 20 of 30 rows are displayed).", "sql": "SELECT orders.id AS order_id, customers.name AS customer_name FROM orders JOIN customers ON orders.customer_id = customers.id LIMIT 100", "columns": ["order_id", "customer_name"], "rows_sample": [[1, "Aarav Sharma"], [5, "Aarav Sharma"], [18, "Aarav Sharma"], [3, "Diya Patel"], [14, "Diya Patel"], [28, "Diya Patel"], [2, "Rohan Mehta"], [11, "Rohan Mehta"], [7, "Ananya Iyer"], [22, "Ananya Iyer"], [4, "Kabir Singh"], [25, "Kabir Singh"], [9, "Ishita Rao"], [30, "Ishita Rao"], [6, "Vikram Nair"], [27, "Vikram Nair"], [12, "Meera Joshi"], [13, "Meera Joshi"], [8, "Arjun Reddy"], [16, "Sara Khan"], [10, "Nikhil Verma"], [29, "Nikhil Verma"], [19, "Pooja Desai"], [21, "Riya Kapoor"], [15, "Karan Malhotra"], [23, "Tanvi Shah"], [17, "Dev Chauhan"], [26, "Neha Gupta"], [20, "Siddharth Menon"], [24, "Aisha Ali"]], "row_count": 30, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 30, "got_row_count": 30, "exact_match": true, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 931, "output_tokens": 245, "latency_s": 1.268, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b04", "tier": "T4", "kind": "sql", "turns": ["Which product categories appear in more than 8 orders?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "637813813df8", "schema_hash": "cace08063546", "commit": "00caf5d", "ran_at": "2026-09-25T09:48:55+00:00", "answer": "The categories that appear in more than 8 orders are **Accessories** and **Electronics**.", "sql": "SELECT p.category FROM order_items AS oi JOIN orders AS o ON oi.order_id = o.id JOIN products AS p ON oi.product_id = p.id WHERE o.status <> 'cancelled' GROUP BY p.category HAVING COUNT(DISTINCT oi.order_id) > 8 LIMIT 100", "columns": ["category"], "rows_sample": [["Accessories"], ["Electronics"]], "row_count": 2, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 2, "got_row_count": 2, "exact_match": true, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 766, "output_tokens": 262, "latency_s": 0.936, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b05", "tier": "T5", "kind": "sql", "turns": ["How many orders were placed each month in 2024?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "637813813df8", "schema_hash": "cace08063546", "commit": "00caf5d", "ran_at": "2026-09-25T09:49:04+00:00", "answer": "In 2024 the monthly order counts were: Jan 2, Feb 2, Mar 3, Apr 2, May 1, Jun 2, Jul 2, Aug 1, Sep 2, Oct 1, Nov 2, Dec 2.", "sql": "SELECT STRFTIME('%Y-%m', order_date) AS month, COUNT(*) AS order_count FROM orders WHERE status <> 'cancelled' AND order_date >= '2024-01-01' AND order_date <= '2024-12-31' GROUP BY month ORDER BY month LIMIT 100", "columns": ["month", "order_count"], "rows_sample": [["2024-01", 2], ["2024-02", 2], ["2024-03", 3], ["2024-04", 2], ["2024-05", 1], ["2024-06", 2], ["2024-07", 2], ["2024-08", 1], ["2024-09", 2], ["2024-10", 1], ["2024-11", 2], ["2024-12", 2]], "row_count": 12, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 12, "got_row_count": 12, "exact_match": false, "projection_match": false, "pass": false}, "llm_calls": 2, "input_tokens": 862, "output_tokens": 362, "latency_s": 1.188, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b06", "tier": "T6", "kind": "sql", "turns": ["What are the top 3 products by units sold?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "637813813df8", "schema_hash": "cace08063546", "commit": "00caf5d", "ran_at": "2026-09-25T09:49:13+00:00", "answer": "The top three products by units sold are Notebook Set (11 units), Gel Pen Pack (9 units) and Wireless Mouse (7 units). Only the first rows are shown.", "sql": "SELECT p.name, SUM(oi.quantity) AS units_sold FROM order_items AS oi JOIN orders AS o ON oi.order_id = o.id JOIN products AS p ON oi.product_id = p.id WHERE o.status <> 'cancelled' GROUP BY p.id, p.name ORDER BY units_sold DESC LIMIT 3", "columns": ["name", "units_sold"], "rows_sample": [["Notebook Set", 11], ["Gel Pen Pack", 9], ["Wireless Mouse", 7]], "row_count": 3, "truncated": false, "error": null, "out_of_scope": false, "checks": {"ref_row_count": 3, "got_row_count": 3, "exact_match": true, "projection_match": true, "pass": true}, "llm_calls": 2, "input_tokens": 808, "output_tokens": 333, "latency_s": 1.141, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
{"id": "b07", "tier": "T7", "kind": "sql", "turns": ["What percentage of total revenue does each customer account for?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "637813813df8", "schema_hash": "cace08063546", "commit": "00caf5d", "ran_at": "2026-09-25T09:49:22+00:00", "answer": "Vikram Nair accounts for 18.47% of total revenue, Ananya Iyer 15.69%, Dev Chauhan 11.99%, Pooja Desai 9.81%, Rohan Mehta 9.53%, Diya Patel 5.50%, Aarav Sharma 4.79%, Nikhil Verma 4.57%, Kabir Singh 3.38%, Riya Kapoor 2.34%, Ishita Rao 2.18%, Karan Malhotra 2.15%, Sara Khan 1.80%, Arjun Reddy 1.80%, Aisha Ali 1.53%, Siddharth Menon 1.31%, Tanvi Shah 1.19%, Meera Joshi 1.11% and Neha Gupta 0.87% of total revenue.", "sql": "SELECT c.id, c.name, SUM(oi.unit_price * oi.quantity) AS revenue, (SUM(oi.unit_price * oi.quantity) * 100.0 / (SELECT SUM(oi2.unit_price * oi2.quantity) FROM order_items AS oi2 JOIN orders AS o2 ON oi2.order_id = o2.id WHERE o2.status <> 'cancelled')) AS revenue_pct FROM customers AS c JOIN orders AS o ON c.id = o.customer_id JOIN order_items AS oi ON o.id = oi.order_id WHERE o.status <> 'cancelled' GROUP BY c.id, c.name ORDER BY revenue_pct DESC LIMIT 100", "columns": ["id", "name", "revenue", "revenue_pct"], "rows_sample": [[7, "Vikram Nair", 33895.0, 18.468370293684956], [4, "Ananya Iyer", 28796.0, 15.690077916416934], [17, "Dev Chauhan", 21999.0, 11.986596196807062], [12, "Pooja Desai", 17998.0, 9.80657113278483], [3, "Rohan Mehta", 17498.0, 9.534136108538114], [2, "Diya Patel", 10094.0, 5.499918269492726], [1, "Aarav Sharma", 8792.0, 4.7904974663542745], [11, "Nikhil Verma", 8396.0, 4.574728927150875], [5, "Kabir Singh", 6197.0, 3.3765596905138127], [14, "Riya Kapoor", 4298.0, 2.341851468424781], [6, "Ishita Rao", 3994.0, 2.176210973682777], [15, "Karan Malhotra", 3947.0, 2.1506020814035853], [10, "Sara Khan", 3299.0, 1.7975262899798399], [9, "Arjun Reddy", 3298.0, 1.7969814199313463], [20, "Aisha Ali", 2799.0, 1.5250912657331226], [19, "Siddh