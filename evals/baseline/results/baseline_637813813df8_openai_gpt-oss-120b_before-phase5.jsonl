{"id": "b08", "tier": "T8", "kind": "clarify", "turns": ["Who are the best customers?"], "model": "openai/gpt-oss-120b", "temperature": 0.0, "prompt_hash": "637813813df8", "schema_hash": "cace08063546", "commit": "00caf5d", "ran_at": "2026-09-25T09:49:32+00:00", "answer": "The best customers are Vikram Nair (Rs 33,895), Ananya Iyer (Rs 28,796), Dev Chauhan (Rs 21,999), Pooja Desai (Rs 17,998), Rohan Mehta (Rs 17,498), Diya Patel (Rs 10,094), Aarav Sharma (Rs 8,792), Nikhil Verma (Rs 8,396), Kabir Singh (Rs 6,197) and Riya Kapoor (Rs 4,298). Only the first rows are shown.", "sql": "SELECT c.id, c.name, c.email, SUM(oi.unit_price * oi.quantity) AS total_spent FROM customers AS c JOIN orders AS o ON c.id = o.customer_id JOIN order_items AS oi ON o.id = oi.order_id WHERE o.status <> 'cancelled' GROUP BY c.id, c.name, c.email ORDER BY total_spent DESC LIMIT 10", "columns": ["id", "name", "email", "total_spent"], "rows_sample": [[7, "Vikram Nair", "vikram.nair@example.com", 33895.0], [4, "Ananya Iyer", "ananya.iyer@example.com", 28796.0], [17, "Dev Chauhan", "dev.chauhan@example.com", 21999.0], [12, "Pooja Desai", "pooja.desai@example.com", 17998.0], [3, "Rohan Mehta", "rohan.mehta@example.com", 17498.0], [2, "Diya Patel", "diya.patel@example.com", 10094.0], [1, "Aarav Sharma", "aarav.sharma@example.com", 8792.0], [11, "Nikhil Verma", "nikhil.verma@example.com", 8396.0], [5, "Kabir Singh", "kabir.singh@example.com", 6197.0], [14, "Riya Kapoor", "riya.kapoor@example.com", 4298.0]], "row_count": 10, "truncated": false, "error": null, "out_of_scope": false, "checks": {"pass": null}, "llm_calls": 2, "input_tokens": 983, "output_tokens": 465, "latency_s": 1.519, "model_reported": "openai/gpt-oss-120b", "status": "ok"}
