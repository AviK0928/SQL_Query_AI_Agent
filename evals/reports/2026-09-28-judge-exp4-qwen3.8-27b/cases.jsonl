{"id": "g17", "repeat": 0, "tier": "T6", "kind": "sql", "earlier_questions": [], "question": "Which 5 customers have spent the most?", "sql": "SELECT customers.id, customers.name, SUM(order_items.unit_price * order_items.quantity) AS total_spent FROM customers JOIN orders ON customers.id = orders.customer_id JOIN order_items ON orders.id = order_items.order_id WHERE orders.status <> 'cancelled' GROUP BY customers.id, customers.name ORDER BY total_spent DESC LIMIT 5", "columns": ["id", "name", "total_spent"], "rows": [[7, "Vikram Nair", 33895.0], [4, "Ananya Iyer", 28796.0], [17, "Dev Chauhan", 21999.0], [12, "Pooja Desai", 17998.0], [3, "Rohan Mehta", 17498.0]], "truncated": false, "limit_reached": true, "answer": "The five customers who have spent the most are Vikram Nair (Rs 33,895), Ananya Iyer (Rs 28,796), Dev Chauhan (Rs 21,999), Pooja Desai (Rs 17,998) and Rohan Mehta (Rs 17,498). Only the first rows are shown.", "reference_sql": "WITH t AS (SELECT o.customer_id, SUM(i.unit_price * i.quantity) AS s FROM order_items i JOIN orders o ON o.id = i.order_id WHERE o.status != 'cancelled' GROUP BY o.customer_id) SELECT c.name FROM t JOIN customers c ON c.id = t.customer_id ORDER BY t.s DESC LIMIT 5", "reference_rows": 5, "matches_reference": true}
